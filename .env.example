# Ledgerly Environment Variables Example

# Neon PostgreSQL pooled connection string (use Neon's pooled connection string, e.g. with '-pooler' in the host and ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth secret key (at least 32 characters random string)
BETTER_AUTH_SECRET=your_better_auth_secret_must_be_at_least_32_chars_long

# Canonical app URL (e.g. http://localhost:3000 in dev, https://your-domain.vercel.app in prod)
BETTER_AUTH_URL=http://localhost:3000

# Google Gemini API key for receipt extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Google Gemini model for receipt vision extraction
GEMINI_MODEL=gemini-2.5-flash

# Fallback Google Gemini model if primary model fails (e.g. on 404/503/429)
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Optional: skip env runtime check during builds
SKIP_ENV_VALIDATION=0
